# Backend REST API base URL (Laravel — see docs/API.md)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# File storage URL (360° photos, thumbnails, audio, etc.)
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/storage

# Optional: extra hosts (comma-separated) whose photos the VR panels may load
# through /api/vr-image. The API/storage hosts above are always allowed.
# VR_IMAGE_HOSTS=res.cloudinary.com
